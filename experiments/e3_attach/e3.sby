# Author: Shchuchkin E. Yu. <shchuchkin-pkims@yandex.ru>
# E3 + E5: read_slang for the design, read_verilog -formal for the checker and wrapper,
# nets attached with rename -output. Expected: good - pass, bad - fail, cover - pass.
[tasks]
good
bad
cover

[options]
good: mode prove
bad: mode prove
bad: expect fail
cover: mode cover
cover: depth 30
multiclock on

[engines]
good: abc pdr
bad: abc pdr
cover: smtbmc

[script]
good: read_slang dut_gray.sv --top dut -G BAD=0
bad: read_slang dut_gray.sv --top dut -G BAD=1
cover: read_slang dut_gray.sv --top dut -G BAD=0
hierarchy -top dut
proc
flatten
cd dut
rename -output u_tx.ptr ofcdc_s0
cd ..
read_verilog -formal ofcdc_gray.v wrap.v
hierarchy -top ofcdc_wrap
proc
flatten
setundef -anyseq t:$buf

[files]
../common/dut_gray.sv
../common/ofcdc_gray.v
wrap.v
